# demo = simulated payment and delivery, test = Telegram test XTR with simulated delivery,
# live = real XTR, unsigned Stars transaction and automatic Premium/GRAM after approval
SHOP_MODE=demo
BOT_TOKEN=
ADMIN_IDS=
DATA_DIR=data

# Optional proxy URLs, e.g. http://127.0.0.1:10809 for a bot running on the same host.
TELEGRAM_PROXY=
FRAGMENT_PROXY=

# Live only. Keep a separate, minimally funded TON wallet.
FRAGMENT_COOKIES=
# For unsigned Stars, provide a TON Connect account (no seed/API key required) or TON_SEED.
TON_SENDER_ACCOUNT=
TON_SEED=
TON_API_KEY=
TON_API_PROVIDER=tonapi
TON_WALLET_VERSION=V5R1
TON_MNEMONIC_TYPE=
# Upper bound in TON per order, including SDK fee and gas reserve.
FRAGMENT_MAX_TON=10
